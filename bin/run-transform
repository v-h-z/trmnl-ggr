#!/usr/bin/env bash
# Run src/transform.rb the way TRMNL's wrapper does and print its output.
cd "$(dirname "$0")/.." || exit 1
echo '{"trmnl":{}}' | ruby -e '
require "json"
input = JSON.parse($stdin.read)
load "src/transform.rb"
out = run(input)
puts JSON.pretty_generate(out)
warn "bytes: #{JSON.generate(out).bytesize}"
'
